{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard_git_push.py\"",
            "shell": "bash",
            "timeout": 180
          },
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard_shell_file_write.py\"",
            "shell": "bash",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard_shell_file_write.py\"",
            "shell": "bash",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(python -m pytest*)",
      "Bash(npx ng test*)",
      "Bash(flutter test*)",
      "Bash(flutter analyze*)",
      "Bash(dart format*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(docker compose ps*)",
      "Bash(docker compose logs*)",
      "Bash(gh run list*)",
      "Bash(gh run view*)"
    ]
  }
}
