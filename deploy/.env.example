# Copy to .env and fill in. .env is gitignored and must never be committed.
#
#   cp .env.example .env
#   openssl rand -base64 32        # for POSTGRES_PASSWORD

POSTGRES_USER=milan
POSTGRES_PASSWORD=change-me-before-first-boot
POSTGRES_DB=milan

# The domain Caddy will get a certificate for. Its A record must already point
# at this host, or ACME issuance fails and the site serves nothing.
MILAN_DOMAIN=milan.example.com

# Where Let's Encrypt sends expiry warnings. A real, monitored address.
MILAN_ACME_EMAIL=ops@example.com

# SPEC.md §14.7 -- the AI capability boundary. "none" (the default if left
# unset) disables recognition entirely; nothing else in Milan depends on it.
# No real provider is registered yet -- setting this to anything but "none"
# still resolves to the disabled placeholder until one is implemented and
# added to app/services/recognition.py's provider registry.
# RECOGNITION_PROVIDER=none
# RECOGNITION_MODEL=

# deploy.sh reads this to know which GHCR repository to pull
# ghcr.io/<this>/api:<tag> and ghcr.io/<this>/web:<tag> from. Only used by a
# tagged deploy.sh run -- "First boot" and "Upgrading" build from source and
# never read it.
MILAN_GHCR_REPOSITORY=jhjh1214/milan-software
