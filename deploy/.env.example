# Copy to .env and fill in. .env is gitignored and must never be committed.
#
#   cp .env.example .env
#   openssl rand -base64 32        # for POSTGRES_PASSWORD

POSTGRES_USER=milan
POSTGRES_PASSWORD=change-me-before-first-boot
POSTGRES_DB=milan

# The domain Caddy will get a certificate for. Its A record must already point
# at this host, or ACME issuance fails and the site serves nothing.
MILAN_DOMAIN=milan.example.com

# Where Let's Encrypt sends expiry warnings. A real, monitored address.
MILAN_ACME_EMAIL=ops@example.com

# SPEC.md §14.7 -- the AI capability boundary. "none" (the default if left
# unset) disables recognition entirely; nothing else in Milan depends on it.
# Set to "anthropic", "openai" or "gemini" and give that provider's own key
# below to turn floor-plan recognition on -- see app/services/
# recognition_providers.py. RECOGNITION_MODEL is optional; each provider
# has a sensible default.
# RECOGNITION_PROVIDER=none
# RECOGNITION_MODEL=

# Only the one named by RECOGNITION_PROVIDER needs a real value -- the other
# two stay blank and are simply never called. Never commit a real key here;
# this file's own values must stay placeholders.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# Leave all three unset to call the real vendor APIs. Set one to point that
# provider at a self-hosted model instead, wrapped to speak that vendor's
# API shape -- e.g. a local model wrapped as the Anthropic Messages API
# behind ANTHROPIC_BASE_URL=http://localhost:8080. The matching *_API_KEY
# above still has to be set to whatever that wrapper expects, even if it is
# not a real vendor credential.
# ANTHROPIC_BASE_URL=
# OPENAI_BASE_URL=
# GEMINI_BASE_URL=

# Seconds before a recognition call gives up (default 120, generous for a
# real hosted vendor). Raise this for a self-hosted model on modest
# hardware -- tested directly against one, a genuinely complex floor plan
# ran at roughly 3 tokens/second, so a detailed plan can take several
# minutes end to end. A timeout still degrades to the same safe
# "not usable this time" result as any other provider failure; it never
# blocks or corrupts anything else.
# RECOGNITION_TIMEOUT_SECONDS=120

# deploy.sh reads this to know which GHCR repository to pull
# ghcr.io/<this>/api:<tag> and ghcr.io/<this>/web:<tag> from. Only used by a
# tagged deploy.sh run -- "First boot" and "Upgrading" build from source and
# never read it.
MILAN_GHCR_REPOSITORY=jhjh1214/milan-software
