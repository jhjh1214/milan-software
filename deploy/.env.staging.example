# Copy to .env on the STAGING box specifically -- this is not the same file
# as .env.example, because a few values are deliberately different there and
# a diff between the two is worth being able to see at a glance.
#
#   cp .env.staging.example .env
#   openssl rand -base64 32        # for POSTGRES_PASSWORD

POSTGRES_USER=milan
POSTGRES_PASSWORD=change-me-before-first-boot
POSTGRES_DB=milan

# Its own subdomain, its own certificate, its own A record -- never the
# production domain. Mixing the two up here means Caddy issues staging's
# certificate for the production hostname, and now the site somebody actually
# depends on has staging's cert.
MILAN_DOMAIN=staging.milan.example.com

# A real, monitored address -- Let's Encrypt's expiry warnings for staging's
# own certificate land here, same as production's.
MILAN_ACME_EMAIL=ops@example.com

# RECOGNITION_PROVIDER=none
# RECOGNITION_MODEL=

# deploy.sh reads this to know which GHCR repository to pull
# ghcr.io/<this>/api:<tag> and ghcr.io/<this>/web:<tag> from.
MILAN_GHCR_REPOSITORY=jhjh1214/milan-software

# What .github/workflows/deploy.yml pushes here on every tag, automatically,
# with no manual step -- see deploy/README.md's "Staging" section for why
# staging gets a release before anyone decides whether production does.
